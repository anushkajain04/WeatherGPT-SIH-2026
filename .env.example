# Server Configuration
PORT=3000
NODE_ENV=development

# Security & CORS (comma-separated list of allowed origins, never wildcard in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/weathergpt?retryWrites=true&w=majority

# Authentication Secrets (minimum 32 characters each)
JWT_SECRET=your_32_character_minimum_jwt_secret_here
OTP_HASH_SECRET=your_32_character_minimum_otp_hash_secret

# Session Cookie Configuration
# COOKIE_SAME_SITE: lax (default) or none (required for cross-domain frontend/backend)
COOKIE_SAME_SITE=lax
# COOKIE_SECURE: true or false (automatically forced true if COOKIE_SAME_SITE=none)
COOKIE_SECURE=false

# Notification Providers (console for dev; production requires real drivers)
MAIL_PROVIDER=console
SMS_PROVIDER=console

# SMTP Configuration (when MAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=WeatherGPT <noreply@weathergpt.local>

# Upstream Python RAG Service
RAG_BASE_URL=https://your-rag-service.onrender.com
RAG_API_KEY=your_upstream_rag_internal_api_key

# Bhashini AI Credentials (from Bhashini Udyat Dashboard)
BHASHINI_UDYAT_KEY=your_bhashini_udyat_key
BHASHINI_INFERENCE_KEY=your_bhashini_inference_key

# Rate Limiting (default 20 requests per 15 minutes per IP)
CHAT_RATE_LIMIT_WINDOW_MS=900000
CHAT_RATE_LIMIT_MAX=20

# Upstream RAG Timeouts (Render free tier cold start vs warm)
RAG_COLD_TIMEOUT_MS=65000
RAG_WARM_TIMEOUT_MS=10000

# Keep Warm Worker (pings /health every 10 mins to prevent Render cold starts; default false)
KEEP_WARM=false

# Optional Client Authentication Key (for protecting existing non-auth endpoints if configured)
CLIENT_API_KEY=

# OpenStreetMap Nominatim Geocoding Contact Email (required for User-Agent policy)
GEOCODING_CONTACT_EMAIL=contact@weathergpt.local
